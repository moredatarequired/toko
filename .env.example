# Copy to .env (git-ignored). Both `direnv` and `just` load it automatically.
# Anything here can instead live under [toko.api_keys] in
# ~/.config/toko/config.toml; the environment always wins.

# Counting for Claude models, via the Anthropic count_tokens endpoint.
ANTHROPIC_API_KEY=

# Counting for Gemini models, via the Google API.
GOOGLE_API_KEY=

# Counting for Grok models, via the xAI API.
XAI_API_KEY=

# Read by huggingface_hub, not by toko: needed for gated tokenizers.
HF_TOKEN=

# Fetch fresh pricing data when the cache is stale. true/1/yes to enable.
TOKO_AUTO_UPDATE_PRICES=

# Accepted in config.toml for symmetry but never read: OpenAI counting is local
# (tiktoken), so no OpenAI credentials are needed.
# OPENAI_API_KEY=
